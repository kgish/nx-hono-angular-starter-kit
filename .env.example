# Local development defaults (match compose.yaml).
DATABASE_URL=postgres://app:app@localhost:5432/app
# No PORT here: Nx loads this file into every task, and the Angular dev server
# would pick it up. The API defaults to 3000.

# Auth. Outside production the API signs sessions with a built-in development
# secret and creates the demo user demo@example.org (password: demo).
# The web app's URL; the dev server proxies /api from here to the API.
BETTER_AUTH_URL=http://localhost:4200
# BETTER_AUTH_SECRET=        # openssl rand -base64 32
# SEED_DEMO_USER=false

# Email (password resets) goes to Mailpit from `npm run db:up`: read it at
# http://localhost:8025. These are the defaults outside production.
# SMTP_URL=smtp://localhost:1025
# MAIL_FROM=Todos <no-reply@localhost>
