# Copy to <DEPLOY_PATH>/.env on the server (default /opt/fullstack/.env).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
HTTP_PORT=80
# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-at-least-32-random-characters
# The public URL users open, e.g. https://todos.example.com. better-auth only
# accepts sign-ins from this origin.
BETTER_AUTH_URL=https://todos.example.com
# true creates demo@example.org with the password "demo". Leave off in production.
SEED_DEMO_USER=false
# SMTP server for password-reset emails (any provider: Postmark, SES, Mailgun, ...).
# smtps:// for TLS on port 465, smtp:// for STARTTLS on 587. URL-encode special
# characters in the user name and password.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Todos <no-reply@todos.example.com>
# Only needed if the web app is served from a different origin than the API.
CORS_ORIGIN=
