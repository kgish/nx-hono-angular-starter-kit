{
  "name": "api-db",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/api/db/src",
  "projectType": "library",
  "tags": ["scope:api", "type:data-access"],
  "targets": {
    "typecheck": {
      "options": {
        "command": "tsc -p libs/api/db/tsconfig.lib.json --noEmit"
      }
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit generate --config libs/api/db/drizzle.config.ts"
      }
    },
    "db-studio": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit studio --config libs/api/db/drizzle.config.ts"
      }
    }
  }
}
